# liste des messages qui sont des réponses à d'autres messages
jq -c '
  . as $data |
  ($data.conversations | map(.messages[].message_id) | unique) as $all_ids |
  $data.conversations[] | .messages[] | {
    sujet: .sujet,
    message_id: .message_id,
    in_reply_to: .in_reply_to,
    existe_parent: (if .in_reply_to then (.in_reply_to | IN($all_ids[])) else false end)
  }
' ppe.json

# enregistrer un variable avec mot de passe dans le trousseau
security add-generic-password \
  -a "$USER" \
  -s "OPENAI_API_KEY" \
  -w

# récuperer
export OPENAI_API_KEY="$(security find-generic-password \
  -a "$USER" \
  -s "OPENAI_API_KEY" \
  -w)"

